{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小雪工具箱",
  "version": "2.3.0-dev",
  "identifier": "com.xueayi.xiaoxue",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "小雪工具箱",
        "width": 1180,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
